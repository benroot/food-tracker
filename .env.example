ANTHROPIC_API_KEY=
# base64-encoded output of generate_password_hash.py -- not the raw pbkdf2:sha256:... hash
AUTH_PASSWORD_HASH=
# Required whenever AUTH_PASSWORD_HASH is set: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Uncomment only to try the login flow over plain http://localhost (never in production)
# ALLOW_INSECURE_COOKIES=1
